{
	"name": "clawdipedia",
	"version": "0.2.0",
	"private": true,
	"license": "MIT",
	"workspaces": {
		"packages": [],
		"catalog": {
			"@types/bun": "1.4.4",
			"@types/node": "26.6.6",
			"eslint-plugin-jsdoc": "65.4.5",
			"markdownlint-cli2": "0.24.0",
			"markdownlint-rule-title-case-style": "0.4.3",
			"oxlint": "1.93.0",
			"oxlint-tsgolint": "7.0.2006",
			"typescript": "7.0.2"
		}
	},
	"scripts": {
		"build": "docusaurus build",
		"check:citations": "bun tools/check/citations.ts",
		"check:docs": "bun tools/check/docs.ts",
		"check:examples": "bun tools/check/examples.ts",
		"check:hosts": "bun tools/check/hosts.ts",
		"clear": "docusaurus clear",
		"deploy:check": "wrangler deploy --dry-run",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"guard": "typescript-bedrock guard",
		"lint": "bun run --sequential --no-exit-on-error oxlint markdownlint-cli2",
		"lint:code": "oxlint",
		"lint:fix": "bun run --sequential --no-exit-on-error 'oxlint --fix' 'markdownlint-cli2 --fix'",
		"llms:check": "bun tools/llms/check.ts",
		"plugin:build": "bun build plugin/mcp/src/server.ts --target=bun --outfile=plugin/mcp/dist/server.js && bun build cli/src/cli.ts --target=bun --outfile=cli/bin/clawdipedia && bun build inspect/mcp/src/server.ts --target=bun --external=oxc-parser --outfile=inspect/mcp/dist/server.js",
		"plugin:check": "bun tools/plugin/check.ts",
		"plugin:smoke": "bun tools/plugin/smoke.ts",
		"release:all": "bun tools/release/cli.ts all",
		"release:check": "bun tools/release/cli.ts check",
		"release:clean": "bun tools/release/cli.ts clean",
		"release:compare": "bun tools/release/cli.ts compare",
		"release:diff": "bun tools/release/cli.ts diff",
		"release:facts": "bun tools/release/cli.ts facts",
		"release:probe:live": "bun tools/release/cli.ts probe:live",
		"release:probe:managed": "bun tools/release/cli.ts probe:managed",
		"release:probe:print": "bun tools/release/cli.ts probe:print",
		"release:probe:pty": "bun tools/release/cli.ts probe:pty",
		"release:prompts": "bun tools/release/cli.ts prompts",
		"release:schemas": "bun tools/release/cli.ts schemas",
		"schemas": "bun tools/schemas/generate.ts && bun tools/schemas/types.ts && bun tools/schemas/code.ts",
		"schemas:check": "bun tools/schemas/check.ts && bun tools/schemas/types.ts --check && bun tools/surface/snapshot.ts --check",
		"schemas:observe": "bun tools/schemas/observe/run.ts",
		"serve": "docusaurus serve",
		"start": "docusaurus start",
		"surface": "bun tools/surface/snapshot.ts --commit && bun tools/surface/render.ts",
		"surface:audit": "CC_INSPECT_CACHE=$PWD/captures bun tools/surface/audit.ts",
		"surface:check": "bun tools/surface/render.ts --check && bun tools/surface/coverage.ts",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "bun check",
		"verify": "bun run --sequential format:check typecheck lint guard test",
		"verify:locked": "sh tools/build-locked.sh",
		"version:bump": "bun tools/version/bump.ts"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@docusaurus/theme-mermaid": "^3.10.2",
		"@easyops-cn/docusaurus-search-local": "^0.55.3",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/lora": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@mantine/core": "^9.8.0",
		"@mantine/hooks": "^9.8.0",
		"@mdx-js/react": "^3.1.1",
		"@mermaid-js/layout-elk": "^1.0.1",
		"clsx": "^2.1.1",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/theme-classic": "^3.10.2",
		"@docusaurus/tsconfig": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "^19.3.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint-plugin-jsdoc": "catalog:",
		"markdownlint-cli2": "catalog:",
		"markdownlint-rule-title-case-style": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"typescript-bedrock": "file:/Users/krystian/.claude/plugins/cache/xsyetopz/bedrock/0.1.4/.bedrock/packages/typescript-bedrock",
		"wrangler": "^4.159.0"
	},
	"overrides": {
		"@types/node": "26.6.6"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4"
}
