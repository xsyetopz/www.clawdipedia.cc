{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"allowUmdGlobalAccess": true,
		"jsx": "preserve",
		"lib": ["ESNext", "DOM"],
		"paths": {
			"@site/*": ["./*"]
		},
		"types": [
			"@docusaurus/module-type-aliases",
			"@docusaurus/theme-classic",
			"bun"
		]
	},
	"exclude": [
		".docusaurus",
		"build",
		"captures",
		"**/dist",
		"**/.build",
		"**/build",
		"**/coverage",
		"**/target"
	],
	"extends": "typescript-bedrock/tsconfig.base.json"
}
